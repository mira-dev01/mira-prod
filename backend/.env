# --- App ---
ENVIRONMENT=development
BACKEND_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000

# --- Database / Cache ---
DATABASE_URL=postgresql+asyncpg://mira:mira@localhost:5432/mira_dev
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SECRET_KEY=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- Vapi.ai (voice orchestration: STT/LLM/TTS/function-calling) ---
# Create a fresh key at https://dashboard.vapi.ai -> Org Settings -> API Keys
VAPI_API_KEY=
# Shared secret Vapi sends back in the `x-vapi-secret` header on every server
# message, so we can verify webhooks actually came from Vapi.
VAPI_WEBHOOK_SECRET=change-me
# Subdomain assigned to your Vapi SIP endpoint, e.g. "mira-prod" -> calls land
# on mira-prod.sip.vapi.ai. Find/set this in Vapi dashboard -> Phone Numbers.
VAPI_SIP_SUBDOMAIN=
VAPI_ASSISTANT_NAME=Mira

# --- Bring-your-own provider keys (registered as Vapi credentials by
#     scripts/setup_vapi_assistant.py so usage bills to your own accounts) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Exotel (telephony) ---
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
# Token we require as a query param on the Exotel-configured callback URL,
# since Exotel does not HMAC-sign webhook payloads.
EXOTEL_WEBHOOK_TOKEN=change-me
# Exotel SIP gateway IP/port, used only by scripts/setup_vapi_assistant.py
# when registering the BYO SIP trunk credential with Vapi.
EXOTEL_GATEWAY_IP=
EXOTEL_GATEWAY_PORT=5070

# --- iCal sync ---
ICAL_SYNC_INTERVAL_MINUTES=15

# --- Pricing defaults (overridable per-property later) ---
DEFAULT_CLEANING_FEE_INR=800
DEFAULT_TAX_PERCENT=12
WEEKEND_SURGE_MULTIPLIER=1.2
