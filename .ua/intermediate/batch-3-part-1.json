      "id": "class:backend/app/voice/conversation_state.py:ConversationState",
      "type": "class",
      "name": "ConversationState",
      "filePath": "backend/app/voice/conversation_state.py",
      "lineRange": [138, 413],
      "summary": "Central mutable state for a live call: tracks selected property, guest slots (dates, guests, location, budget), conversation goal, escalation status, closing/farewell state, quoted price, and per-entity salience scores for attention-aware ranking.",
      "tags": ["data-model", "middleware"],
      "complexity": "complex"
    },
    {
      "id": "file:backend/app/voice/conversation_style.py",
      "type": "file",
      "name": "conversation_style.py",
      "filePath": "backend/app/voice/conversation_style.py",
      "summary": "Implements the ConversationStyle data model and StyleEngine — a hysteresis-smoothed language/tone tracker that analyzes each guest turn's character ratios to determine whether Mira should respond in English, Hindi (Devanagari), or Hinglish, plus a pipecat ConversationStyleProcessor to wire it into the pipeline.",
      "tags": ["middleware", "service"],
      "complexity": "complex",
      "languageNotes": "Weighted exponential decay over a rolling window of TurnSignal entries prevents rapid language oscillation caused by code-switching in individual turns."
    },
    {
      "id": "class:backend/app/voice/conversation_style.py:StyleEngine",
      "type": "class",
      "name": "StyleEngine",
      "filePath": "backend/app/voice/conversation_style.py",
      "lineRange": [230, 315],
      "summary": "Core hysteresis algorithm: consumes per-turn TurnSignal entries and produces a new ConversationStyle by computing weighted English/Devanagari ratios, applying lock-in thresholds, and carrying forward previous_style to smooth rapid switches.",
      "tags": ["service", "middleware"],
      "complexity": "complex"
    },
    {
      "id": "class:backend/app/voice/conversation_style.py:ConversationStyleProcessor",
