    {
      "id": "file:backend/app/voice/conversation_state.py",
      "type": "file",
      "name": "conversation_state.py",
      "filePath": "backend/app/voice/conversation_state.py",
      "summary": "Defines ConversationState — the authoritative mutable store for all conversation facts: locked property, guest slots, recommendations shown, escalation flag, closing state, conversation goal, and attention salience tracking.",
      "tags": ["data-model", "middleware"],
      "complexity": "complex",
      "languageNotes": "Uses a hysteresis-aware _recompute_goal method to derive ConversationGoal from slot/lock state, keeping goal transitions predictable."
    },
