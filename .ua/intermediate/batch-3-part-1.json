      "type": "file",
      "name": "conversation_quality.py",
      "filePath": "backend/app/voice/conversation_quality.py",
      "summary": "Defines the ConversationQuality accumulator and ValidationResult record used by all pipeline guard processors to log quality observations; ConversationQuality also manages the pending_style_correction flag that bridges style compliance back to StatePromptSyncProcessor.",
      "tags": ["data-model", "type-definition", "middleware"],
      "complexity": "simple",
      "languageNotes": "Uses frozen dataclasses for ValidationResult to guarantee immutability across async pipeline stages."
    },
    {
      "id": "class:backend/app/voice/conversation_quality.py:ConversationQuality",
      "type": "class",
      "name": "ConversationQuality",
      "filePath": "backend/app/voice/conversation_quality.py",
      "lineRange": [61, 83],
      "summary": "Mutable accumulator for per-call quality observations; records ValidationResult entries and tracks pending_style_correction — the only deliberate cross-concern bridge between quality observation and behavioral nudging.",
      "tags": ["data-model", "middleware"],
      "complexity": "simple"
    },
